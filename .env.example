# ==============================================================
# HRP Obyektivka (Resume/CV) Parser - Environment Configuration
# ==============================================================

# LLM Inference Endpoint (Ollama or OpenAI-compatible server)
OLLAMA_HOST=http://127.0.0.1:11434

# Model Selection: Recommended to use instruction-following models (e.g. qwen2.5:14b-instruct or gemma4-31b)
OBYEKTIVKA_MODEL=qwen2.5:14b-instruct

# Inference Parameters
OBYEKTIVKA_TIMEOUT_SECONDS=300
OBYEKTIVKA_NUM_CTX=32768
OBYEKTIVKA_NUM_PREDICT=16384
OBYEKTIVKA_TEMPERATURE=0.0

# Optional Gemini Fallback (if using gemini_parser.py)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# File Constraints
MAX_FILE_SIZE_MB=20
